{
  "name": "my-quote",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "description": "MY-Quote 划词引用：鼠标选中 AI 回复的文字，弹出「引用」按钮一键复制到输入框。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}